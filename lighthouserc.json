{
    "ci": {
        "collect": {
            "staticDistDir": "./dist",
            "url": [
                "http://localhost/",
                "http://localhost/tutoriais/",
                "http://localhost/categorias/",
                "http://localhost/ferramentas/",
                "http://localhost/faq/",
                "http://localhost/sobre/"
            ],
            "numberOfRuns": 1
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "warn",
                    {
                        "minScore": 0.75
                    }
                ],
                "largest-contentful-paint": [
                    "warn",
                    {
                        "maxNumericValue": 4000
                    }
                ],
                "cumulative-layout-shift": [
                    "warn",
                    {
                        "maxNumericValue": 0.1
                    }
                ],
                "total-blocking-time": [
                    "warn",
                    {
                        "maxNumericValue": 300
                    }
                ]
            }
        }
    }
}
